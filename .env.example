# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/receitas_db?schema=public"

# ============================================
# CONFIGURAÇÕES DA API
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO
# ============================================
JWT_SECRET="receitas-app-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
